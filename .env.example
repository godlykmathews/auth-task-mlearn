# npm run setup generates .env.local with a random secret and a local database.
JWT_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=file:./data/harbor.db
# Required for a remote Turso/libSQL database; never prefix secrets with NEXT_PUBLIC_.
DATABASE_AUTH_TOKEN=
# Vercel's Turso integration may instead set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# Set to your exact HTTPS production origin when deploying.
APP_URL=http://localhost:3000
